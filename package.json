{
  "name": "archie-transport",
  "version": "0.5.0",
  "description": "Minimal ARCHIE workspace and enrolled-runner transport. Current typed-Delta model source is tracked separately until exact live files are imported.",
  "private": true,
  "type": "module",
  "bin": {
    "archied": "scripts/archied.mjs",
    "archied-hosted": "scripts/archied-hosted.mjs",
    "archie-hybrid-runner": "scripts/archie-hybrid-runner.mjs",
    "archie-enrolled-hybrid-runner": "scripts/archie-enrolled-hybrid-runner.mjs"
  },
  "files": [
    "scripts/archied.mjs",
    "scripts/archied-hosted.mjs",
    "scripts/archie-hybrid-runner.mjs",
    "scripts/archie-enrolled-hybrid-runner.mjs",
    "scripts/archie-hybrid-protocol.mjs",
    "scripts/archie-workspace-core.mjs",
    "scripts/archie-workspace-portable.mjs",
    "scripts/archie-workspace-file-provider.mjs",
    "scripts/archie-workspace-service.mjs",
    "scripts/maker-engine.mjs",
    "scripts/check-engineering-language.mjs",
    "tools/archie_one_body.py",
    "labs/archie-one-surface/index.html",
    "README.md",
    "ENGINEERING_LANGUAGE.md",
    "ARCHIE_HISTORY_COMPACT.md",
    "00-ARCHIE-MODEL/BENCHMARKS.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "archied": "node scripts/archied.mjs",
    "archied:hosted": "node scripts/archied-hosted.mjs",
    "runner": "node scripts/archie-hybrid-runner.mjs",
    "runner:enrolled": "node scripts/archie-enrolled-hybrid-runner.mjs",
    "view": "python3 tools/archie_one_body.py",
    "test:workspace": "node --test scripts/tests/archie-workspace-substrate.test.mjs",
    "test:hosted": "node --test scripts/tests/archied-hosted.test.mjs scripts/tests/archie-enrolled-hybrid-runner.test.mjs",
    "check:language": "node scripts/check-engineering-language.mjs"
  }
}
