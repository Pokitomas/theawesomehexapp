FROM node:24-bookworm-slim

ENV NODE_ENV=production \
    ARCHIE_HOME=/data \
    ARCHIED_HOST=0.0.0.0 \
    ARCHIED_PORT=8787

WORKDIR /app

COPY package.json ./
COPY scripts/archie-hybrid-runner.mjs scripts/archie-hybrid-runner.mjs
COPY scripts/archie-enrolled-hybrid-runner.mjs scripts/archie-enrolled-hybrid-runner.mjs
COPY scripts/archie-hybrid-protocol.mjs scripts/archie-hybrid-protocol.mjs
COPY scripts/archied-hosted.mjs scripts/archied-hosted.mjs
COPY scripts/archied.mjs scripts/archied.mjs
COPY scripts/archie-hosted-backup.mjs scripts/archie-hosted-backup.mjs
COPY scripts/archie-hosted-security.mjs scripts/archie-hosted-security.mjs
COPY scripts/archie-workspace-core.mjs scripts/archie-workspace-core.mjs
COPY scripts/archie-workspace-portable.mjs scripts/archie-workspace-portable.mjs
COPY scripts/archie-workspace-file-provider.mjs scripts/archie-workspace-file-provider.mjs
COPY scripts/archie-workspace-service.mjs scripts/archie-workspace-service.mjs
COPY scripts/maker-engine.mjs scripts/maker-engine.mjs

RUN mkdir -p /data && chown -R node:node /app /data

USER node

EXPOSE 8787
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:8787/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]

CMD ["node", "scripts/archied-hosted.mjs"]
